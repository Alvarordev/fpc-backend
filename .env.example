NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fpc_dev:fpc_dev_password@localhost:5432/fpc_dev
JWT_SECRET=replace-with-a-development-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=refresh_token
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-development-password
# Semilla del PRNG de `npm run seed:demo`. Misma semilla, mismo dataset.
SEED_DEMO_SEED=20260805
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PATIENT_SUMMARY_RATE_LIMIT=10
PATIENT_SUMMARY_RATE_LIMIT_WINDOW_SECONDS=60
# Vacío desactiva la integración con n8n por completo.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_MS=5000
