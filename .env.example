NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fpc_dev:fpc_dev_password@localhost:5432/fpc_dev
JWT_SECRET=replace-with-a-development-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
